---
import Layout from '../layouts/Layout.astro';

const CTA_URL = "https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso";
const CTA_TARGET = "_blank";
const CTA_REL = "nofollow sponsored noopener";
---

<Layout>
  <!-- TOP NAVIGATION HEADER (Ultra-slim, Gaming Hardware Style) -->
  <header class="sticky top-0 z-50 w-full bg-[#080808]/95 backdrop-blur-md border-b border-[#232329] shadow-lg">
    <!-- Top 1px Red Accent Line -->
    <div class="w-full h-[2px] bg-gradient-to-r from-transparent via-[#E60012] to-transparent"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Logo: XSUS // -->
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none" aria-label="XSUS 官网首页">
        <div class="w-8 h-8 bg-[#0D0D11] border border-[#E60012]/60 flex items-center justify-center font-mono font-black text-white text-lg tracking-tighter group-hover:border-[#FF1538] group-hover:shadow-[0_0_12px_rgba(230,0,18,0.5)] transition-all">
          <span class="text-[#E60012] group-hover:text-[#FF1538]">X</span>
        </div>
        <div class="flex items-baseline gap-1">
          <span class="font-tech text-2xl font-black tracking-widest text-white uppercase group-hover:text-gray-100 transition-colors">XSUS</span>
          <span class="text-[#E60012] font-black text-lg">//</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center space-x-6 lg:space-x-8 text-sm font-medium text-[#A7A7AD]" aria-label="主导航">
        <a href="#hero" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">首页</a>
        <a href="#pricing" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">套餐方案</a>
        <a href="#explore" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">探索 XSUS</a>
        <a href="#nodes" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">全球节点</a>
        <a href="#highlights" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">应用场景</a>
        <a href="#clients" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">客户端</a>
        <a href="#why-us" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">核心优势</a>
        <a href="#guide" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">使用指南</a>
        <a href="#faq" class="hover:text-white hover:text-[#FF1538] transition-colors py-1">常见问题</a>
      </nav>

      <!-- Right Action CTA -->
      <div class="hidden sm:flex items-center space-x-4">
        <a 
          href={CTA_URL} 
          target={CTA_TARGET} 
          rel={CTA_REL}
          class="text-xs font-semibold text-[#A7A7AD] hover:text-white transition-colors tracking-wider uppercase px-3 py-1.5"
        >
          登录
        </a>
        <a 
          href={CTA_URL} 
          target={CTA_TARGET} 
          rel={CTA_REL}
          class="relative group overflow-hidden bg-[#E60012] hover:bg-[#FF1538] text-white text-xs font-bold uppercase tracking-wider px-5 py-2.5 rounded-[2px] transition-all duration-300 shadow-[0_0_15px_rgba(230,0,18,0.3)] hover:shadow-[0_0_25px_rgba(255,21,56,0.6)] flex items-center gap-1.5"
        >
          <span>立即注册</span>
          <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center sm:hidden">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="text-[#A7A7AD] hover:text-white p-2 focus:outline-none"
          aria-label="打开菜单"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden sm:hidden bg-[#0B0B0D] border-b border-[#232329] px-4 pt-3 pb-6 space-y-3">
      <div class="flex flex-col space-y-2 text-sm text-[#A7A7AD]">
        <a href="#hero" class="mobile-nav-link py-2 hover:text-[#FF1538] border-b border-white/5">首页</a>
        <a href="#pricing" class="mobile-nav-link py-2 hover:text-[#FF1538] border-b border-white/5">套餐方案</a>
        <a href="#explore" class="mobile-nav-link py-2 hover:text-[#FF1538] border-b border-white/5">探索 XSUS</a>
        <a href="#nodes" class="mobile-nav-link py-2 hover:text-[#FF1538] border-b border-white/5">全球节点</a>
        <a href="#highlights" class="mobile-nav-link py-2 hover:text-[#FF1538] border-b border-white/5">应用场景</a>
        <a href="#clients" class="mobile-nav-link py-2 hover:text-[#FF1538] border-b border-white/5">客户端支持</a>
        <a href="#why-us" class="mobile-nav-link py-2 hover:text-[#FF1538] border-b border-white/5">核心优势</a>
        <a href="#guide" class="mobile-nav-link py-2 hover:text-[#FF1538] border-b border-white/5">使用指南</a>
        <a href="#faq" class="mobile-nav-link py-2 hover:text-[#FF1538]">常见问题</a>
      </div>
      <div class="pt-3 flex gap-3">
        <a 
          href={CTA_URL} 
          target={CTA_TARGET} 
          rel={CTA_REL}
          class="flex-1 text-center py-2.5 bg-[#18181B] text-white text-xs font-semibold rounded-[2px]"
        >
          登录
        </a>
        <a 
          href={CTA_URL} 
          target={CTA_TARGET} 
          rel={CTA_REL}
          class="flex-1 text-center py-2.5 bg-[#E60012] text-white text-xs font-bold rounded-[2px] shadow-red-edge"
        >
          立即注册
        </a>
      </div>
    </div>
  </header>

  <!-- HERO SECTION (Gaming Brand Giant Banner, 620-760px desktop) -->
  <section id="hero" class="relative w-full min-h-[640px] lg:min-h-[720px] bg-[#050505] overflow-hidden flex items-center cyber-grid border-b border-[#18181B]">
    <!-- Ambient Red & Blue Tech Glow Background -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-[#E60012]/15 blur-[140px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[400px] bg-[#0051FF]/10 blur-[120px] rounded-full pointer-events-none"></div>
    
    <!-- Fine Cyber Speed Lines -->
    <div class="absolute inset-0 opacity-20 pointer-events-none bg-[radial-gradient(#E60012_1px,transparent_1px)] [background-size:24px_24px]"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 w-full relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Hero Content -->
        <div class="lg:col-span-7 space-y-6 text-left">
          
          <!-- Category Tag -->
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#111115] border border-[#E60012]/40 rounded-[2px]">
            <span class="w-2 h-2 rounded-full bg-[#FF1538] animate-pulse"></span>
            <span class="font-mono text-[11px] font-bold tracking-widest text-[#A7A7AD] uppercase">XSUS HIGH PERFORMANCE NETWORK</span>
          </div>

          <!-- Main H1 Headline -->
          <div class="space-y-1">
            <div class="font-tech text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white uppercase leading-none">
              XSUS
            </div>
            <h1 class="text-3xl sm:text-5xl lg:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-[#FF1538] tracking-tight leading-tight">
              为速度而生，不只是快，更要稳
            </h1>
          </div>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg text-[#A7A7AD] max-w-2xl leading-relaxed">
            面向游戏竞技、4K/8K 影音、全球 AI 模型与跨境网络场景的高速网络加速服务。低延迟节点覆盖，多设备无缝连接，全天候稳定在线。
          </p>

          <!-- Core Badges (Horizontal) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 pb-2">
            <div class="bg-[#0B0B0D] border border-[#232329] p-2.5 rounded-[2px] flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF1538] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span class="text-xs font-semibold text-gray-200">高速节点</span>
            </div>
            <div class="bg-[#0B0B0D] border border-[#232329] p-2.5 rounded-[2px] flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF1538] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-xs font-semibold text-gray-200">极低延迟</span>
            </div>
            <div class="bg-[#0B0B0D] border border-[#232329] p-2.5 rounded-[2px] flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF1538] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
              </svg>
              <span class="text-xs font-semibold text-gray-200">全球线路</span>
            </div>
            <div class="bg-[#0B0B0D] border border-[#232329] p-2.5 rounded-[2px] flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF1538] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="text-xs font-semibold text-gray-200">多设备支持</span>
            </div>
          </div>

          <!-- Hero CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a 
              href={CTA_URL} 
              target={CTA_TARGET} 
              rel={CTA_REL}
              class="inline-flex items-center justify-center gap-2 bg-[#E60012] hover:bg-[#FF1538] text-white font-bold text-sm uppercase tracking-wider px-8 py-4 rounded-[2px] transition-all duration-300 shadow-[0_0_20px_rgba(230,0,18,0.4)] hover:shadow-[0_0_35px_rgba(255,21,56,0.7)] group"
            >
              <span>立即使用 XSUS</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a 
              href="#pricing" 
              class="inline-flex items-center justify-center gap-2 bg-[#111115] hover:bg-[#18181B] text-white border border-[#232329] hover:border-[#E60012] font-semibold text-sm tracking-wider px-8 py-4 rounded-[2px] transition-all duration-300"
            >
              <span>查看套餐</span>
            </a>
          </div>

        </div>

        <!-- Right Hero Visual: 3D Cyber Network Core Apparatus -->
        <div class="lg:col-span-5 relative flex items-center justify-center">
          <div class="relative w-full max-w-[460px] aspect-square bg-[#0B0B0E]/90 border border-[#232329] rounded-[4px] p-6 shadow-2xl flex flex-col justify-between overflow-hidden group">
            
            <!-- Tech corner markers -->
            <div class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-[#FF1538]"></div>
            <div class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-[#FF1538]"></div>
            <div class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-[#FF1538]"></div>
            <div class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-[#FF1538]"></div>

            <!-- Header of Visual Machine -->
            <div class="flex items-center justify-between border-b border-[#18181B] pb-3 text-xs font-mono text-[#A7A7AD]">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-white font-bold tracking-wider">XSUS QUANTUM CORE V4</span>
              </div>
              <span class="text-[#FF1538]">STATUS: ACTIVE</span>
            </div>

            <!-- Central Hardware Apparatus Diagram -->
            <div class="relative my-4 flex items-center justify-center py-6">
              
              <!-- Concentric Outer Ring -->
              <div class="absolute w-56 h-56 rounded-full border border-dashed border-[#E60012]/30 animate-[spin_25s_linear_infinite]"></div>
              <div class="absolute w-44 h-44 rounded-full border border-[#00F0FF]/20 animate-[spin_15s_linear_infinite_reverse]"></div>
              
              <!-- Center Glowing Reactor -->
              <div class="relative w-28 h-28 bg-gradient-to-br from-[#18181B] to-[#080808] border-2 border-[#FF1538] rounded-full flex flex-col items-center justify-center shadow-[0_0_30px_rgba(230,0,18,0.5)]">
                <div class="font-tech text-lg font-black text-white tracking-widest">XSUS</div>
                <div class="font-mono text-[10px] text-[#FF1538] tracking-widest">10 Gbps</div>
                <div class="w-8 h-0.5 bg-[#FF1538] mt-1"></div>
              </div>

              <!-- Orbiting Telemetry Badges -->
              <div class="absolute top-0 right-4 bg-[#111115] border border-[#232329] px-2.5 py-1 rounded-[2px] text-[11px] font-mono text-emerald-400 shadow-lg">
                HK: <span class="font-bold">14ms</span>
              </div>
              <div class="absolute bottom-2 left-4 bg-[#111115] border border-[#232329] px-2.5 py-1 rounded-[2px] text-[11px] font-mono text-cyan-400 shadow-lg">
                JP: <span class="font-bold">29ms</span>
              </div>
              <div class="absolute top-1/2 -left-2 -translate-y-1/2 bg-[#111115] border border-[#232329] px-2 py-1 rounded-[2px] text-[11px] font-mono text-amber-400 shadow-lg">
                US: <span class="font-bold">115ms</span>
              </div>
            </div>

            <!-- Bottom Telemetry Stream -->
            <div class="bg-[#070709] border border-[#18181B] p-3 rounded-[2px] space-y-1.5 font-mono text-[11px]">
              <div class="flex justify-between text-[#A7A7AD]">
                <span>ROUTING PROTOCOL</span>
                <span class="text-white">BGP MULTI-HOMED</span>
              </div>
              <div class="flex justify-between text-[#A7A7AD]">
                <span>PACKET LOSS RATE</span>
                <span class="text-emerald-400 font-bold">0.00%</span>
              </div>
              <div class="w-full bg-[#18181B] h-1.5 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-[#E60012] to-[#FF1538] h-full w-[94%]"></div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Hero Bottom Scroll Indicator -->
      <div class="pt-10 flex justify-center">
        <a href="#pricing" class="flex flex-col items-center gap-1.5 text-[11px] font-mono tracking-widest text-[#71717A] hover:text-[#FF1538] transition-colors">
          <span>SCROLL TO EXPLORE</span>
          <svg class="w-4 h-4 animate-bounce text-[#FF1538]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PRODUCT EXPLORE CATEGORIES (White/Light Contrast Bar inspired by Hardware Categories) -->
  <section id="explore" class="w-full bg-[#FFFFFF] text-[#080808] py-14 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center space-y-2 mb-10">
        <h2 class="font-tech text-2xl sm:text-3xl font-black tracking-wider uppercase text-[#050505]">
          探索 XSUS
        </h2>
        <p class="text-sm sm:text-base text-gray-600 max-w-xl mx-auto">
          为不同场景量身定制的高性能加速通道，一键解锁全场景网络自由
        </p>
      </div>

      <!-- Horizontal Grid / Scroll Bar -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        
        <!-- Cat 1 -->
        <a href="#nodes" class="group bg-[#F4F4F5] hover:bg-[#080808] hover:text-white p-5 rounded-[4px] border-b-2 border-transparent hover:border-[#E60012] transition-all duration-300 flex flex-col items-center text-center space-y-3 shadow-sm hover:shadow-xl">
          <div class="w-12 h-12 rounded-[2px] bg-white group-hover:bg-[#18181B] flex items-center justify-center text-[#E60012] group-hover:text-[#FF1538] shadow-sm transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-sm group-hover:text-white">全球节点</h3>
            <p class="text-xs text-gray-500 group-hover:text-gray-400 mt-0.5">高速骨干网络</p>
          </div>
        </a>

        <!-- Cat 2 -->
        <a href="#highlights" class="group bg-[#F4F4F5] hover:bg-[#080808] hover:text-white p-5 rounded-[4px] border-b-2 border-transparent hover:border-[#E60012] transition-all duration-300 flex flex-col items-center text-center space-y-3 shadow-sm hover:shadow-xl">
          <div class="w-12 h-12 rounded-[2px] bg-white group-hover:bg-[#18181B] flex items-center justify-center text-[#E60012] group-hover:text-[#FF1538] shadow-sm transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-sm group-hover:text-white">影音解锁</h3>
            <p class="text-xs text-gray-500 group-hover:text-gray-400 mt-0.5">4K/8K 极速流畅</p>
          </div>
        </a>

        <!-- Cat 3 -->
        <a href="#highlights" class="group bg-[#F4F4F5] hover:bg-[#080808] hover:text-white p-5 rounded-[4px] border-b-2 border-transparent hover:border-[#E60012] transition-all duration-300 flex flex-col items-center text-center space-y-3 shadow-sm hover:shadow-xl">
          <div class="w-12 h-12 rounded-[2px] bg-white group-hover:bg-[#18181B] flex items-center justify-center text-[#E60012] group-hover:text-[#FF1538] shadow-sm transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-sm group-hover:text-white">游戏加速</h3>
            <p class="text-xs text-gray-500 group-hover:text-gray-400 mt-0.5">极低延迟与抖动</p>
          </div>
        </a>

        <!-- Cat 4 -->
        <a href="#highlights" class="group bg-[#F4F4F5] hover:bg-[#080808] hover:text-white p-5 rounded-[4px] border-b-2 border-transparent hover:border-[#E60012] transition-all duration-300 flex flex-col items-center text-center space-y-3 shadow-sm hover:shadow-xl">
          <div class="w-12 h-12 rounded-[2px] bg-white group-hover:bg-[#18181B] flex items-center justify-center text-[#E60012] group-hover:text-[#FF1538] shadow-sm transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-sm group-hover:text-white">AI 工具</h3>
            <p class="text-xs text-gray-500 group-hover:text-gray-400 mt-0.5">ChatGPT/Claude直连</p>
          </div>
        </a>

        <!-- Cat 5 -->
